{
	"geode": "6.0.0-beta.1",
	"gd": {
		"win": "2.2091",
		"android": "2.2091",
		"mac": "2.2091",
		"ios": "2.2091"
	},
	"id": "meltyonice.eye-strain-helper",
	"name": "Eye Strain Helper",
	"version": "v2.0.0-beta.1",
	"developer": "PinkSickle",
	"description": "Keep your eyes healthy while playing GD!",
	"dependencies": {
		"geode.node-ids": ">=1.24.0-beta.1"
	},
	"links": {
		"source": "https://codeberg.org/meltyonice/eye-strain-helper"
	},
	"tags": [
		"utility",
		"interface",
		"offline",
		"universal"
	],
	"resources": {
		"sprites": [
			"resources/GE_button_05.png"
		],
		"files": [
			"resources/break_over.ogg"
		]
	},
	"settings": {
		"timeBetweenBreaks": {
			"type": "float",
			"name": "Time between breaks (in minutes)",
			"default": 20.0,
			"min": 0.5,
			"max": 1480.0,
			"control": {
				"input": true,
				"slider": false
			}
		},
		"shortBreakDuration": {
			"type": "int",
			"name": "Short break duration (in seconds)",
			"default": 30,
			"min": 2,
			"max": 600,
			"control": {
				"input": true,
				"slider": false
			}
		},
		"breakAtCheckpoints": {
			"type": "bool",
			"name": "Breaks at Platformer Checkpoints",
			"default": true
		},
		"breakDuringAutos": {
			"type": "bool",
			"name": "Breaks during Auto levels",
			"description": "Only does anything when playing rated auto levels",
			"default": true
		},
		"pauseAfterBreak": {
			"type": "bool",
			"name": "Pause after breaks",
			"default": true
		},
		"skippingTitle": {
			"type": "title",
			"name": "Skipping"
		},
		"allowSkipping": {
			"type": "bool",
			"name": "Allow skipping",
			"default": false
		},
		"limitSkipping": {
			"type": "bool",
			"name": "Limit skipping",
			"default": true
		},
		"maxSkips": {
			"type": "int",
			"name": "Maximum concurrent skips",
			"default": 1,
			"min": 1
		}
	}
}
